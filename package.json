{
    "name": "koma",
    "version": "0.1.0",
    "private": true,
    "description": "Local-first desktop manga reader built with Electron, React, and TypeScript.",
    "main": "dist/main/main.js",
    "type": "module",
    "scripts": {
        "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
        "dev:renderer": "vite --host 127.0.0.1",
        "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.node.json && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
        "build": "tsc -p tsconfig.node.json && vite build",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
        "preview": "vite preview --host 127.0.0.1",
        "generate-icon": "node scripts/generate-icon.mjs"
    },
    "dependencies": {
        "@vitejs/plugin-react": "latest",
        "electron-store": "latest",
        "react": "latest",
        "react-dom": "latest"
    },
    "devDependencies": {
        "@types/node": "latest",
        "@types/react": "latest",
        "@types/react-dom": "latest",
        "concurrently": "latest",
        "cross-env": "latest",
        "electron": "latest",
        "sharp": "^0.34.5",
        "typescript": "latest",
        "vite": "latest",
        "wait-on": "latest"
    }
}
